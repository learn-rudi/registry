{
  "id": "stack:content-extractor",
  "kind": "stack",
  "name": "Content Extractor",
  "version": "1.0.0",

  "lifecycle": {
    "maturity": "stable",
    "support": "supported"
  },

  "delivery": "remote",
  "install": {
    "source": "catalog",
    "path": "catalog/stacks/content-extractor"
  },
  "runtime": "node",
  "requires": {
    "binaries": [
      "playwright",
      "tesseract"
    ],
    "secrets": [
      {
        "key": "SUPA_DATA_API",
        "label": "Supadata API Key",
        "required": false,
        "helpUrl": "https://supadata.ai"
      },
      {
        "key": "REDDIT_BEARER_TOKEN",
        "label": "Reddit Bearer Token",
        "required": false,
        "helpUrl": "https://www.reddit.com/prefs/apps"
      },
      {
        "key": "REDDIT_CLIENT_ID",
        "label": "Reddit Client ID",
        "required": false,
        "helpUrl": "https://www.reddit.com/prefs/apps"
      },
      {
        "key": "REDDIT_CLIENT_SECRET",
        "label": "Reddit Client Secret",
        "required": false,
        "helpUrl": "https://www.reddit.com/prefs/apps"
      }
    ]
  },
  "provides": {
    "tools": [
      "extract_youtube",
      "extract_reddit",
      "extract_tiktok",
      "extract_article",
      "extract_github",
      "extract_links",
      "extract_batch"
    ]
  },
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "tsx",
      "src/index.ts"
    ],
    "cwd": "."
  },
  "meta": {
    "description": "Extract content from YouTube, Reddit, TikTok, web articles, GitHub, and link batches",
    "author": "CO-LLAB",
    "license": "MIT",
    "category": "data-extraction",
    "tags": [
      "youtube",
      "reddit",
      "tiktok",
      "article",
      "github",
      "links",
      "batch",
      "transcript",
      "extraction",
      "scraping"
    ],
    "icon": "📥"
  },
  "related": {
    "operatorSkill": "skill:content-extractor",
    "skills": [
      "skill:content-extractor"
    ]
  }
}
