{
  "id": "stack:notion-workspace",
  "kind": "stack",
  "name": "Notion Workspace",
  "version": "1.2.0",
  "delivery": "remote",
  "install": {
    "source": "catalog",
    "path": "catalog/stacks/notion-workspace"
  },
  "runtime": "node",
  "requires": {
    "binaries": [],
    "secrets": [
      {
        "key": "NOTION_API_KEY",
        "label": "Notion API Key",
        "required": true,
        "helpUrl": "https://www.notion.so/my-integrations"
      }
    ]
  },
  "provides": {
    "tools": [
      "notion_search",
      "notion_get_page",
      "notion_get_page_content",
      "notion_create_page",
      "notion_append_content",
      "notion_delete_page",
      "notion_list_databases",
      "notion_query_database",
      "notion_create_database",
      "notion_add_database_row",
      "notion_db_list",
      "notion_db_add",
      "notion_db_remove",
      "notion_batch_add_rows",
      "notion_update_row",
      "notion_get_database_schema",
      "notion_search_all_databases",
      "notion_duplicate_page",
      "notion_add_block",
      "notion_move_page",
      "notion_update_page_properties",
      "notion_get_page_tree"
    ]
  },
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "tsx",
      "src/index.ts"
    ],
    "cwd": "."
  },
  "meta": {
    "description": "Search, create, and manage Notion pages and databases",
    "author": "CO-LLAB",
    "license": "MIT",
    "category": "documents",
    "tags": [
      "notion",
      "pages",
      "databases",
      "workspace",
      "capability:manage",
      "provider:notion"
    ],
    "icon": "📝"
  },
  "related": {
    "operatorSkill": "skill:notion-workspace",
    "skills": [
      "skill:notion-workspace"
    ]
  }
}
