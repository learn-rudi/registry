{
  "id": "stack:sports-stats",
  "kind": "stack",
  "name": "Sports Stats",
  "version": "1.0.0",
  "delivery": "remote",
  "install": {
    "source": "catalog",
    "path": "catalog/stacks/sports-stats"
  },
  "runtime": "node",
  "requires": {
    "binaries": [],
    "secrets": []
  },
  "provides": {
    "tools": [
      "extract_nba_stats",
      "save_nba_splits",
      "query_nba_db"
    ]
  },
  "mcp": {
    "transport": "stdio",
    "command": "npx",
    "args": [
      "tsx",
      "src/index.ts"
    ],
    "cwd": "."
  },
  "meta": {
    "description": "Extract and query sports statistics from Basketball Reference, ESPN, and other sports sites",
    "author": "CO-LLAB",
    "license": "MIT",
    "category": "data",
    "tags": [
      "sports",
      "nba",
      "basketball",
      "statistics",
      "analytics",
      "basketball-reference",
      "capability:analyze",
      "domain:sports"
    ],
    "icon": "🏀"
  },
  "related": {
    "operatorSkill": "skill:sports-stats",
    "skills": [
      "skill:sports-stats"
    ]
  }
}
