{
  "mcpServers": {
    "audio-tools": {
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/audio-tools-mcp",
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "AUDIO_TOOLS_CONFIG": "${AUDIO_TOOLS_CONFIG}",
        "AUDIO_TOOLS_OUTPUT_DIR": "${AUDIO_TOOLS_OUTPUT_DIR}",
        "AUDIO_TOOLS_DB_PATH": "${AUDIO_TOOLS_DB_PATH}",
        "AUDIO_TOOLS_FFMPEG": "${AUDIO_TOOLS_FFMPEG}",
        "AUDIO_TOOLS_FFPROBE": "${AUDIO_TOOLS_FFPROBE}",
        "AUDIO_TOOLS_WHISPER": "${AUDIO_TOOLS_WHISPER}",
        "AUDIO_TOOLS_WHISPER_MODEL": "${AUDIO_TOOLS_WHISPER_MODEL}",
        "AUDIO_TOOLS_YTDLP": "${AUDIO_TOOLS_YTDLP}",
        "AUDIO_TOOLS_AGENT_NAME": "${AUDIO_TOOLS_AGENT_NAME}",
        "AUDIO_TOOLS_AGENT_MODEL": "${AUDIO_TOOLS_AGENT_MODEL}",
        "AUDIO_TOOLS_PROMPT_TEMPLATE": "${AUDIO_TOOLS_PROMPT_TEMPLATE}",
        "RUDI_OUTPUT_DIR": "${RUDI_OUTPUT_DIR}"
      }
    }
  }
}
