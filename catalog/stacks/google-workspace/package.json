{
  "name": "google-workspace-mcp",
  "version": "1.0.0",
  "description": "Google Workspace MCP Server for Claude Code",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test:auth": "node auth.test.cjs",
    "test:drive": "node drive.test.cjs",
    "test:calendar": "node --import tsx calendar.test.cjs",
    "test:gmail": "node --import tsx gmail.test.cjs",
    "test:slides": "node --import tsx slides.test.cjs",
    "test:tasks": "node --import tsx tasks.test.cjs",
    "test:state": "node --import tsx state.test.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "googleapis": "^140.0.0",
    "dotenv": "^16.0.0",
    "open": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
