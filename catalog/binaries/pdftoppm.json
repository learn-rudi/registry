{
  "id": "binary:pdftoppm",
  "kind": "binary",
  "name": "pdftoppm",
  "version": "system",
  "delivery": "system",
  "install": {
    "source": "system"
  },
  "bins": [
    "pdftoppm"
  ],
  "detect": {
    "command": "pdftoppm -v",
    "expectExitCode": 0
  },
  "installHints": {
    "brew": "brew install poppler",
    "apt": "sudo apt install poppler-utils",
    "manual": "Install Poppler and ensure pdftoppm is available on PATH."
  },
  "meta": {
    "description": "PDF page renderer from Poppler",
    "category": "document-processing",
    "tags": [
      "pdf",
      "rendering",
      "poppler"
    ]
  }
}
