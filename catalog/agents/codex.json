{
  "id": "agent:codex",
  "kind": "agent",
  "name": "OpenAI Codex",
  "version": "latest",

  "delivery": "remote",
  "install": {
    "source": "npm",
    "package": "@openai/codex"
  },

  "bins": ["codex"],

  "detect": {
    "command": "codex --version",
    "expectExitCode": 0
  },

  "auth": {
    "required": true,
    "command": "codex login",
    "instructions": "Run 'codex login' to authenticate with your ChatGPT account or configure an OpenAI API key"
  },

  "meta": {
    "description": "OpenAI Codex CLI - AI coding assistant",
    "category": "ai-assistant",
    "homepage": "https://developers.openai.com/codex/cli",
    "executionOwner": "openai",
    "headlessCommand": "codex exec --json <prompt>"
  }
}
