{
  "id": "agent:gemini",
  "kind": "agent",
  "name": "Gemini CLI",
  "version": "latest",

  "delivery": "remote",
  "install": {
    "source": "npm",
    "package": "@google/gemini-cli"
  },

  "bins": ["gemini"],

  "detect": {
    "command": "gemini --version",
    "expectExitCode": 0
  },

  "auth": {
    "required": true,
    "command": "gemini",
    "instructions": "For headless Gemini CLI use a Gemini API key, Vertex AI, or eligible enterprise Code Assist credentials. For a personal Google AI Pro/Ultra subscription, use Antigravity CLI instead."
  },

  "meta": {
    "description": "Google Gemini CLI - AI coding assistant",
    "category": "ai-assistant",
    "homepage": "https://geminicli.com/docs/",
    "executionOwner": "google",
    "credentialModes": ["api-key", "vertex-ai", "enterprise-code-assist"],
    "headlessCommand": "gemini --prompt <prompt> --output-format stream-json"
  }
}
