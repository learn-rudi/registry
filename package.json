{
  "name": "@rudi/registry",
  "version": "2.0.1",
  "description": "RUDI Registry - Source of truth for stacks, runtimes, binaries, and agents",
  "type": "module",
  "scripts": {
    "validate:v2": "tsx src/validate.ts",
    "validate:public": "tsx src/public-readiness.ts",
    "validate": "npm run validate:v2",
    "compile": "tsx src/compile.ts",
    "indexes:sync": "npm run compile && tsx src/index-sync.ts --write",
    "indexes:check": "npm run compile && tsx src/index-sync.ts --check",
    "catalog:clean:check": "tsx src/catalog-hygiene.ts --dry-run",
    "catalog:clean": "tsx src/catalog-hygiene.ts --apply",
    "stacks:verify": "tsx src/verify-stacks.ts",
    "release:verify": "tsx src/verify-release.ts",
    "debt:scan": "node catalog/stacks/swe-engineering/src/tools/agent-debt-scan.cjs --repo . --config .debt-scan.json --profile ci --severity warning --json",
    "build": "npm run validate && npm run compile",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "index.json",
    "dist/index.json",
    "dist/index.*.json",
    "dist/catalog.sha256.json",
    "dist/release.json",
    "catalog/agents/**/*.json",
    "catalog/binaries/**/*.json",
    "catalog/runtimes/**/*.json",
    "catalog/stacks/**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,py,txt}",
    "catalog/stacks/**/*.sql",
    "!catalog/stacks/**/node_modules/**",
    "!catalog/stacks/**/runs/**",
    "!catalog/stacks/**/downloads/**",
    "!catalog/stacks/**/tmp/**",
    "!catalog/stacks/**/.chrome-profiles/**",
    "!catalog/stacks/**/.test-rudi/**",
    "!catalog/stacks/**/clips/**",
    "!catalog/stacks/**/output/**",
    "!catalog/stacks/**/outputs/**",
    "!catalog/stacks/**/composer/public/media/**",
    "!catalog/**/.DS_Store",
    "catalog/skills/**/*",
    "!catalog/skills/**/node_modules/**",
    "!catalog/skills/**/runs/**",
    "!catalog/skills/**/output/**",
    "!catalog/skills/**/outputs/**",
    "README.md",
    "LICENSE",
    "SCHEMA.md"
  ],
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
